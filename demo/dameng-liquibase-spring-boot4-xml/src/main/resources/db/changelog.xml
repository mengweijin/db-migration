<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ALL_OBJECTS"
>
    <!--
        表名称用引号引起来避免关键词冲突：objectQuotingStrategy="QUOTE_ALL_OBJECTS" 参考：
        https://docs.liquibase.com/concepts/changelogs/attributes/objectquotingstrategy.html#xml_example
    -->

    <preConditions>
        <!-- 前置条件（非必须）。当数据库类型为 DM 并且用户为 VT_TEST 时执行。 -->
        <dbms type="DM"/>
        <runningAs username="VT_TEST"/>
    </preConditions>

    <changeSet id="1" author="mengweijin">
        <createTable tableName="person">
            <column name="id" type="int">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="firstname" type="varchar(50)"/>
            <column name="lastname" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="char(2)"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="mengweijin">
        <addColumn tableName="person">
            <column name="username" type="varchar(8)"/>
        </addColumn>
    </changeSet>

    <!-- 表名称为关键词的测试 -->
    <changeSet id="3" author="mengweijin">
        <createTable tableName="group">
            <column name="id" type="int">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 主键自增测试 -->
    <changeSet id="4" author="mengweijin">
        <createTable tableName="table_with_auto_increment">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="table_with_auto_increment">
            <column name="name" value="张三"/>
        </insert>
        <insert tableName="table_with_auto_increment">
            <column name="name" value="李四"/>
        </insert>
    </changeSet>

    <!-- 主键自增测试 - 指定起始和步长 -->
    <changeSet id="5" author="mengweijin">
        <createTable tableName="table_with_auto_increment_2">
            <column name="id" type="int" autoIncrement="true" startWith="1000" incrementBy="5">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="table_with_auto_increment_2">
            <column name="name" value="王五"/>
        </insert>
        <insert tableName="table_with_auto_increment_2">
            <column name="name" value="赵六"/>
        </insert>
    </changeSet>

    <!--  preConditions 测试（表不存在时才创建 - sys_user 当前不存在，实际会创建）  -->
    <changeSet id="6" author="mengweijin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sys_user" schemaName="VT_TEST"/>
            </not>
        </preConditions>
        <createTable tableName="sys_user">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!--  preConditions 测试（表不存在时才创建 - sys_user 已经存在，实际不会会创建列包含 age 的表）  -->
    <changeSet id="7" author="mengweijin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sys_user"/>
            </not>
        </preConditions>
        <createTable tableName="sys_user">
            <column name="id" type="int">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="age" type="int">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>